---
import Navbar from "../components/navigations/Navbar.astro";
import Footer from "../components/navigations/Footer.astro";
import LanguageSwitcher from "../components/navigations/LanguageSwitcher.astro";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-pt-24 scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Amin Tailor - Bespoke Tailoring" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content={import.meta.env.GOOGLE_SITE_VERIFICATION} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,700;1,400;1,500;1,700&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-ivory text-charcoal font-sans overflow-x-hidden">
    <Navbar />
    <LanguageSwitcher />
    <slot />
    <Footer />
  </body>
</html>
