---
import Navbar from "../components/navigations/Navbar.astro";
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-pt-24 scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content={import.meta.env.GOOGLE_SITE_VERIFICATION} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>

    <style>
      @import url("https://fonts.googleapis.com/css2?family=Inter&family=Poppins&display=swap");
    </style>
    <style>
      * {
        font-family: "Poppins", sans-serif;
      }
    </style>
    <slot name="page-meta" />
  </head>
  <body>
    <Navbar />
    <slot />
    <footer class="mt-10 bg-ground-800 py-2 text-center text-xs text-white">
      Amin Tailor
    </footer>
  </body>
</html>
