---
const linkStyle = "block font-body transition-colors duration-300 hover:text-white mb-3";
---

<footer id="site-footer" style="background-color: #1A1A1A;">
  <div class="page-padding content-max pt-20 pb-10">
    <!-- Top Section -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8">
      <!-- Brand Column -->
      <div class="footer-col" data-footer-col>
        <div class="flex items-center gap-2.5 mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 250 250" class="h-8 w-8 flex-shrink-0">
            <g transform="translate(42, 25)">
              <path d="M 50,180 C 10,130 10,70 50,50 C 90,30 110,90 100,120" fill="none" stroke="#C9A96E" stroke-width="6" stroke-linecap="round"/>
              <path d="M 160,200 L 100,20" fill="none" stroke="#FFFFFF" stroke-width="8" stroke-linecap="round"/>
              <ellipse cx="109" cy="47" rx="2" ry="6" transform="rotate(-20, 109, 47)" fill="#1A1A1A"/>
              <path d="M 100,120 C 95,100 100,60 109,47 C 115,35 130,20 150,40" fill="none" stroke="#C9A96E" stroke-width="4" stroke-dasharray="3,3"/>
              <line x1="58" y1="120" x2="128" y2="120" stroke="#C9A96E" stroke-width="7" stroke-linecap="round"/>
            </g>
          </svg>
          <span class="font-label text-sm font-semibold tracking-[0.15em] text-white" data-i18n="footer.brand">AMIN TAILOR</span>
        </div>
        <p class="font-body" style="color: rgba(255,255,255,0.5);" data-i18n="footer.tagline">
          Jahit Premium & Bespoke Tailoring
        </p>
      </div>

      <!-- Links Column -->
      <div class="footer-col" data-footer-col>
        <a href="#layanan" class={linkStyle} style="color: rgba(255,255,255,0.6);" data-i18n="footer.nav.services">Layanan</a>
        <a href="#koleksi" class={linkStyle} style="color: rgba(255,255,255,0.6);" data-i18n="footer.nav.collection">Koleksi</a>
        <a href="#tentang" class={linkStyle} style="color: rgba(255,255,255,0.6);" data-i18n="footer.nav.about">Tentang Kami</a>
        <a href="#kontak" class={linkStyle} style="color: rgba(255,255,255,0.6);" data-i18n="footer.nav.contact">Hubungi Kami</a>
      </div>

      <!-- Contact Column -->
      <div class="footer-col" data-footer-col>
        <a
          href="https://wa.me/6281548619166"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 font-body transition-colors duration-300 hover:text-white mb-3"
          style="color: rgba(255,255,255,0.6);"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          +62 815-4861-9166
        </a>
        <a
          href="https://maps.app.goo.gl/ayL4NCdeiccMM2bM6"
          target="_blank"
          rel="noopener noreferrer"
          class="font-caption transition-colors duration-300 hover:text-white flex items-center gap-2"
          style="color: rgba(255,255,255,0.4);"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          Solo, Indonesia
        </a>
      </div>
    </div>

    <!-- Divider -->
    <div class="my-12 w-full" style="height: 1px; background-color: rgba(255,255,255,0.1);" />

    <!-- Bottom Section -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="font-caption" style="color: rgba(255,255,255,0.3);" data-i18n="footer.copyright">
        &copy; 2025 Amin Tailor. All rights reserved.
      </p>
      <div class="flex gap-6">
        <span class="font-caption cursor-default" style="color: rgba(255,255,255,0.3);" data-i18n="footer.privacy">Privacy</span>
        <span class="font-caption cursor-default" style="color: rgba(255,255,255,0.3);" data-i18n="footer.terms">Terms</span>
      </div>
    </div>
  </div>
</footer>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const footer = document.getElementById("site-footer");
  if (footer) {
    const cols = footer.querySelectorAll("[data-footer-col]");
    gsap.set(cols, { opacity: 0, y: 30 });

    ScrollTrigger.create({
      trigger: footer,
      start: "top 90%",
      once: true,
      onEnter: () => {
        gsap.to(cols, {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: "expo.out",
          stagger: 0.1,
        });
      },
    });
  }
</script>
