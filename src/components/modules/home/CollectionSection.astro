---
const galleryItems = [
  { id: 1, src: "/assets/gallery-1.jpg", alt: "Man in charcoal suit", tall: true },
  { id: 2, src: "/assets/gallery-2.jpg", alt: "Hand-stitched suit interior", tall: false },
  { id: 3, src: "/assets/gallery-3.jpg", alt: "Woman in cream tailored outfit", tall: true },
  { id: 4, src: "/assets/gallery-4.jpg", alt: "Fabric swatches", tall: false },
  { id: 5, src: "/assets/gallery-5.jpg", alt: "Man in navy suit", tall: true },
  { id: 6, src: "/assets/gallery-6.jpg", alt: "Buttonhole detail", tall: false },
  { id: 7, src: "/assets/gallery-7.jpg", alt: "Couple in tailored clothing", tall: true },
  { id: 8, src: "/assets/gallery-8.jpg", alt: "Bespoke suits on hangers", tall: false },
];
---

<section
  id="koleksi"
  class="relative page-padding"
  style="background-color: #FAF7F2; min-height: 100vh;"
>
  <div class="content-max mx-auto pt-[120px]">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="scroll-reveal" data-reveal-y="30">
        <span class="font-label block mb-4" style="color: #C9A96E;" data-i18n="collection.label">
          KOLEKSI
        </span>
      </div>
      <div data-str>
        <h2 class="font-display-l" style="color: #1A1A1A;" data-i18n="collection.heading">
          <span class="block overflow-hidden">
            <span class="str-line">Karya Terbaik Kami</span>
          </span>
        </h2>
      </div>
    </div>

    <!-- Gallery Grid -->
    <div id="gallery-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {galleryItems.map((item) => (
        <div
          class="gallery-item relative overflow-hidden will-change-[clip-path,transform]"
          style={`aspect-ratio: ${item.tall ? "3/4" : "1/1"};`}
          data-gallery-item
        >
          <img
            src={item.src}
            alt={item.alt}
            class="w-full h-full object-cover will-change-transform"
            loading={item.id <= 4 ? "eager" : "lazy"}
          />
        </div>
      ))}
    </div>

    <!-- Gallery Caption -->
    <div class="scroll-reveal text-center mt-12" data-reveal-y="20">
      <p class="font-caption" style="color: #8C8278;" data-i18n="collection.caption">
        Galeri Karya Amin Tailor
      </p>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const section = document.getElementById("koleksi");
  const grid = document.getElementById("gallery-grid");

  if (section && grid) {
    const items = grid.querySelectorAll("[data-gallery-item]");
    const images = grid.querySelectorAll("[data-gallery-item] img");
    const isDesktop = window.matchMedia("(min-width: 1024px)").matches;

    // Set initial states
    gsap.set(items, {
      clipPath: "inset(0 40% 0 40% round 0px)",
    });
    gsap.set(images, {
      scale: 2.5,
    });

    // 3D entrance + expansion timeline
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
        end: "center center",
        scrub: 1,
      },
    });

    // Phase 1: 3D entrance (only on desktop)
    if (isDesktop) {
      gsap.set(items, {
        opacity: 0,
        rotateY: -8,
        rotateX: 5,
        z: -1200,
        transformPerspective: 1400,
        transformStyle: "preserve-3d",
      });

      tl.to(items, {
        opacity: 1,
        rotateY: 0,
        rotateX: 0,
        z: 0,
        duration: 0.5,
        ease: "none",
        stagger: 0.02,
      });
    } else {
      gsap.set(items, { opacity: 0 });
      tl.to(items, { opacity: 1, duration: 0.3, ease: "none" });
    }

    // Phase 2: Image expansion
    tl.to(
      items,
      {
        clipPath: "inset(0 0% 0 0% round 0px)",
        duration: 0.5,
        ease: "none",
        stagger: 0.02,
      },
      isDesktop ? 0.3 : 0.1,
    );

    tl.to(
      images,
      {
        scale: 1,
        duration: 0.5,
        ease: "none",
        stagger: 0.02,
      },
      isDesktop ? 0.3 : 0.1,
    );

    // Phase 3: Shape morph (parallax scroll)
    const tl2 = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "center center",
        end: "bottom top",
        scrub: 1,
      },
    });

    tl2.to(items, {
      clipPath: "inset(0 25% 0 25% round 100px)",
      duration: 0.5,
      ease: "none",
      stagger: 0.02,
    });

    // Parallax on images (desktop only)
    if (isDesktop) {
      images.forEach((img) => {
        gsap.to(img, {
          yPercent: 10,
          ease: "none",
          scrollTrigger: {
            trigger: img.parentElement,
            start: "top bottom",
            end: "bottom top",
            scrub: 1,
          },
        });
      });
    }
  }
</script>
