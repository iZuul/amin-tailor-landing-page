---
import { Image } from "astro:assets";
import MenWomenClothesImage from "../../../assets/images/men-women-clothes.webp";
import SchoolUniformImage from "../../../assets/images/school-uniform.webp";
import UniformImage from "../../../assets/images/uniform.webp";
import SuitImage from "../../../assets/images/suit.webp";
---

<div id="our-services" class="mx-5 my-5 lg:mx-10 lg:my-20 xl:mx-0">
  <h2
    class="pb-4 mb-4 text-center text-base font-semibold text-ground-900 md:text-3xl"
  >
    Layanan.
  </h2>
  <div class="grid gap-5 md:grid-cols-2 lg:gap-10 xl:grid-cols-4">
    <figure class="group/service-img relative rounded">
      <Image
        src={MenWomenClothesImage}
        alt={`Tailor Room`}
        width={320}
        height={480}
        class:list="text-center object-cover w-full md:h-banner xl:lg:h-banner-lg rounded-xl"
        loading="lazy"
        decoding="async"
      />
      <div
        class="absolute left-0 top-0 h-full w-full rounded-xl bg-black/30 opacity-0 transition ease-in-out group-hover/service-img:block group-hover/service-img:opacity-100"
      >
        <div
          class="flex h-full items-center justify-center px-5 text-2xl font-bold text-white"
        >
          <span class="text-center leading-10 tracking-widest"
            >Pakaian <br /> Pria dan Wanita</span
          >
        </div>
      </div>
    </figure>
    <figure class="group/service-img relative rounded">
      <Image
        src={SchoolUniformImage}
        alt={`Tailor Room`}
        width={320}
        height={720}
        class:list="text-center object-cover w-full md:h-banner xl:lg:h-banner-lg rounded-xl"
        loading="lazy"
        decoding="async"
      />
      <div
        class="absolute left-0 top-0 h-full w-full rounded-xl bg-black/30 opacity-0 transition ease-in-out group-hover/service-img:block group-hover/service-img:opacity-100"
      >
        <div
          class="flex h-full items-center justify-center px-5 text-2xl font-bold text-white"
        >
          <span class="text-center leading-10 tracking-widest"
            >Seragam <br/> Sekolah</span
          >
        </div>
      </div>
    </figure>
    <figure class="group/service-img relative rounded">
      <Image
        src={UniformImage}
        alt={`Tailor Room`}
        width={320}
        height={720}
        class:list="text-center object-cover w-full md:h-banner xl:lg:h-banner-lg rounded-xl"
        loading="lazy"
        decoding="async"
      />
      <div
        class="absolute left-0 top-0 h-full w-full rounded-xl bg-black/30 opacity-0 transition ease-in-out group-hover/service-img:block group-hover/service-img:opacity-100"
      >
        <div
          class="flex h-full items-center justify-center px-5 text-2xl font-bold text-white"
        >
          <span class="text-center leading-10 tracking-widest"
            >Seragam <br/> Kantor / Kerja</span
          >
        </div>
      </div>
    </figure>
    <figure class="group/service-img relative rounded">
      <Image
        src={SuitImage}
        alt={`Tailor Room`}
        width={320}
        height={720}
        class:list="text-center object-cover w-full md:h-banner xl:lg:h-banner-lg rounded-xl"
        loading="lazy"
        decoding="async"
      />
      <div
        class="absolute left-0 top-0 h-full w-full rounded-xl bg-black/30 opacity-0 transition ease-in-out group-hover/service-img:block group-hover/service-img:opacity-100"
      >
        <div
          class="flex h-full items-center justify-center px-5 text-2xl font-bold text-white"
        >
          <span class="text-center leading-10 tracking-widest"
            >Pembuatan <br/> Jas</span
          >
        </div>
      </div>
    </figure>
  </div>
</div>
