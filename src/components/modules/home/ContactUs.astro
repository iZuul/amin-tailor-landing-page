---
---

<section
  id="kontak"
  class="page-padding"
  style="background-color: #FAF7F2; padding-top: 160px; padding-bottom: 160px;"
>
  <div class="max-w-[640px] mx-auto text-center">
    <!-- Decorative Rule -->
    <div
      data-rule
      class="mx-auto mb-6"
      style="height: 1px; background-color: #C9A96E; opacity: 0.4; width: 0;"
    />

    <!-- Heading -->
    <div data-str>
      <h2 class="font-display-l" style="color: #1A1A1A;" data-i18n="contact.heading">
        <span class="block overflow-hidden">
          <span class="str-line">Siap Membuat</span>
        </span>
        <span class="block overflow-hidden">
          <span class="str-line">Pakaian Impian Anda?</span>
        </span>
      </h2>
    </div>

    <!-- Body Text -->
    <div class="scroll-reveal" data-reveal-y="30" data-reveal-delay="0.2">
      <p class="font-body-l mt-6 mb-10" style="color: rgba(26,26,26,0.7);" data-i18n="contact.body">
        Jangan ragu untuk menghubungi kami. Konsultasi pertama Anda adalah gratis, dan kami dengan senang hati akan membantu mewujudkan visi Anda.
      </p>
    </div>

    <!-- CTA Button -->
    <div class="scroll-reveal" data-reveal-y="20" data-reveal-delay="0.3">
      <a
        href="https://wa.me/6281548619166?text=Halo%20Amin%20Tailor%2C%20saya%20ingin%20konsultasi%20tentang"
        target="_blank"
        rel="noopener noreferrer"
        id="contact-cta"
        class="inline-block font-label text-white px-12 py-4 rounded-full transition-all duration-400 hover:-translate-y-0.5"
        style="background-color: #1A1A1A; font-size: 14px; letter-spacing: 0.04em; font-weight: 500;"
        data-wa=""
        data-i18n="contact.cta"
      >
        Mulai Perjalanan Anda
      </a>
    </div>

    <!-- Contact Info Row -->
    <div class="scroll-reveal" data-reveal-delay="0.4">
      <div class="flex flex-col md:flex-row items-center justify-center gap-6 md:gap-12 mt-12">
        <a
          href="https://wa.me/6281548619166"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-sm transition-colors duration-300 text-charcoal hover:text-champagne"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="#C9A96E">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          +62 815-4861-9166
        </a>

        <a
          href="https://maps.app.goo.gl/ayL4NCdeiccMM2bM6"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-sm transition-colors duration-300 text-charcoal hover:text-champagne"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C9A96E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          Solo, Indonesia
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // CTA hover
  const cta = document.getElementById("contact-cta");
  if (cta) {
    cta.addEventListener("mouseenter", () => {
      cta.style.backgroundColor = "#C9A96E";
      cta.style.boxShadow = "0 8px 30px rgba(201,169,110,0.3)";
    });
    cta.addEventListener("mouseleave", () => {
      cta.style.backgroundColor = "#1A1A1A";
      cta.style.boxShadow = "none";
    });
  }
</script>
